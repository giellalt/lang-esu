! COMING THIS WAY                                                                     |
!--------------------------|----------------------------|-----------------------------|
uk                    DemAbsSg;
ukegg                 DemAbsSg; 
uk:uk+'u           DemNonAbsSg;
ukegg:ukg+u        DemNonAbsSg;
uk:ukeg+ku    DemIntermedNonSg; 
ukegg:ukeg+ku DemIntermedNonSg; 
uka                 DemAdv2Ter;  
