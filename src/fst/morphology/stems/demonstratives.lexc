LEXICON Demonstrative
!--------------------------|----------------------------|-----------------------------|
!          extended        |         restricted         |           obscured          |
!--------------------------|----------------------------|-----------------------------|
! OVER THERE                                                                          |
! or GOING AWAY (au͡g)                                                                 |
!--------------------------|----------------------------|-----------------------------|
au͡g                DemAbsSg; ing                DemAbsSg; am                  DemAbsSg;
au͡g:au͡g+'u      DemNonAbsSg; ing:ing+'u      DemNonAbsSg; am:am+'u         DemNonAbsSg;
au͡g:au͡g+ku DemIntermedNonSg; ing:ing+ku DemIntermedNonSg; am:am+ku    DemIntermedNonSg;
au͡g:aw+ku  DemIntermedNonSg;                                                                
ava              DemAdv2Ter; yaa             DemAdv2Ter;  ama                   DemAdv; 
!--------------------------|----------------------------|-----------------------------|
! ACROSS THERE                                                                        |
!--------------------------|----------------------------|-----------------------------|
ag                 DemAbsSg; ik                 DemAbsSg; akem                DemAbsSg;
                             ikegg              DemAbsSg;                             
ag:ag+'u        DemNonAbsSg; ik:ik+'u        DemNonAbsSg; akem:ak'm+u      DemNonAbsSg;
                             ikegg:ikg+u     DemNonAbsSg;                             
ag:ag+ku   DemIntermedNonSg; ik:ikeg+ku DemIntermedNonSg; akem:akem+ku DemIntermedNonSg;
                             ikegg:ikeg+ku DemIntermedNonSg;
agaa             DemAdv2Ter; ika              DemAdv2Ter; akma                  DemAdv;
ii               DemAdv2Ter;                                                         
!--------------------------|----------------------------|-----------------------------|
! UP THE SLOPE                                                                        |
!--------------------------|----------------------------|-----------------------------|
pau͡g                 DemAbsSg; ping                 DemAbsSg; pam                 DemAbsSg;
pau͡g:pau͡g+'u      DemNonAbsSg; ping:ping+'u      DemNonAbsSg; pam:pam+'u       DemNonAbsSg;
pau͡g:pau͡g+ku DemIntermedNonSg; ping:ping+ku DemIntermedNonSg; pam:pam+ku  DemIntermedNonSg;
pava               DemAdv2Ter; pia                DemAdv2Ter; pama                  DemAdv; 
!--------------------------|----------------------------|-----------------------------|
! UP ABOVE                                                                            |
!--------------------------|----------------------------|-----------------------------|
pag                DemAbsSg; pik                  DemAbsSg; pakem                  DemAbsSg;
                             pikegg               DemAbsSg;
pag:pag+'u      DemNonAbsSg; pik:pik+'u        DemNonAbsSg; pakem:pak'm+u       DemNonAbsSg;
                             pikegg:pikg+u     DemNonAbsSg;
pag:pag+ku DemIntermedNonSg; pik:pikeg+ku DemIntermedNonSg; pakem:pakem+ku DemIntermedNonSg;
                             pikegg:pikeg+ku DemIntermedNonSg;
pagaa            DemAdv2Ter; pika               DemAdv2Ter; pakma                    DemAdv; 
pii              DemAdv2Ter;
!--------------------------|----------------------------|-----------------------------|
! INSIDE, INLAND, OR UPRIVER                                                          |
!--------------------------|----------------------------|-----------------------------|
qau͡g                 DemAbsSg; kiug                 DemAbsSg; qam                DemAbsSg;
                               kiu͡g                 DemAbsSg;
qau͡g:qau͡g+'u      DemNonAbsSg; kiug:kiug+u       DemNonAbsSg; qam:qam+'u      DemNonAbsSg;
                               kiu͡g:kiu͡g+'u      DemNonAbsSg;
qau͡g:qau͡g+ku DemIntermedNonSg; kiug:kiug+ku DemIntermedNonSg; qam:qam+ku DemIntermedNonSg;
                               kiu͡g:kiu͡g+ku DemIntermedNonSg;
qava             DemAdv2Ter;   kia                DemAdv2Ter; qama                 DemAdv; 
!--------------------------|----------------------------|-----------------------------|
! OUTSIDE                                                                             |
!--------------------------|----------------------------|-----------------------------|
qag                DemAbsSg; kegg                DemAbsSg; qakem               DemAbsSg;
qag:qag+'u      DemNonAbsSg; kegg:kegg+'u     DemNonAbsSg; qakem:qak'm+u     DemNonAbsSg;
qag:qag+ku DemIntermedNonSg; kegg:keg+ku DemIntermedNonSg; qakem:qakem+ku DemIntermedNonSg;
qagaa            DemAdv2Ter; kegga             DemAdv2Ter; qakma                 DemAdv; 
qii              DemAdv2Ter;
!--------------------------|----------------------------|-----------------------------|
! DOWN BELOW OR DOWN THE SLOPE                                                        |
!--------------------------|----------------------------|-----------------------------| 
                             ka              DemAbsSgIrr; cam                 DemAbsSg;
un:un+'u        DemNonAbsSg; kan:kat+'u      DemNonAbsSg; cam:cam+'u       DemNonAbsSg;
un:un+ku   DemIntermedNonSg; kan:kan+ku DemIntermedNonSg; cam:cam+ku  DemIntermedNonSg;
una              DemAdv2Ter; kana             DemAdv2Ter; cama                  DemAdv;
un[DemPro]-[Abs][SgUnpd]:un+'a             EncliticOrEnd; 
un[DemPro]-[Voc][SgUnpd]:un@+yuuq    EncliticOrEnd;  
un[DemPro]-[Voc][SgUnpd]:un@+suuq    EncliticOrEnd;  
!--------------------------|----------------------------|-----------------------------|
! DOWNRIVER OR NEAR THE EXIT                                                          |
!--------------------------|----------------------------|-----------------------------|
uneg                 DemAbsSg; ug                 DemAbsSg; cakem                  DemAbsSg;
uneg:ung+'u       DemNonAbsSg; ug:ug+'u        DemNonAbsSg; cakem:cak'm+u       DemNonAbsSg;
uneg:uneg+ku DemIntermedNonSg; ug:ug+ku   DemIntermedNonSg; cakem:cakem+ku DemIntermedNonSg;
un'ga              DemAdv2Ter; ua               DemAdv2Ter; cakma                    DemAdv; 
un'gaa             DemAdv2Ter;
