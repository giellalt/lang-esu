! HERE, NEAR SPEAKER                                                                  |
!--------------------------|----------------------------|-----------------------------|
ma              DemAbsSgIrr; u                  DemAbsSg; im                  DemAbsSg;
man:mat+'u      DemNonAbsSg; u:u+u           DemNonAbsSg; im:im'u             DemNonAbsSg;
                                                          im:imu              DemNonAbsSg;
man:ma+ku  DemIntermedNonSg; u:u+ku     DemIntermedNonSg; im:imku        DemIntermedNonSg;
maa              DemAdv2Ter; wa                   DemAdv; 
                                                          ima                   DemAdv;
u[DemPro]-[Via][SgUnpd]:u+u+ggun      EncliticOrEnd;
maa[DemAdv]-[Via]:gguun               EncliticOrEnd;  
wa[DemAdv]-[Via]:u+u+ggun             EncliticOrEnd;                                                          
maa[DemAdv]-[Equ]:maa+ten             EncliticOrEnd;
wa[DemAdv]-[Equ]:wa+ten               EncliticOrEnd;
!--------------------------|----------------------------|-----------------------------|
! THERE, NEAR LISTENER OR IN CONTEXT                                                  |
!--------------------------|----------------------------|-----------------------------|
tama                 DemAbsSg; tau                DemAbsSg; 
tama:tama+tu      DemNonAbsSg; tau             DemNonAbsSg; 
tama:tama+ku DemIntermedNonSg; tau:tau+ku DemIntermedNonSg; 
tamaa              DemAdv2Ter; tua                  DemAdv;  
                               tava                 DemAdv;
                                                         
tua[DemAdv]-[Equ]:tua+ten                    EncliticOrEnd;
tava[DemAdv]-[Equ]:tava+ten                  EncliticOrEnd;
tayima         EncliticOrEnd;
taima          EncliticOrEnd;
