!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!                                           !!!
!!!            Obsolete Verb -ete-            !!!
!!!   Encountered only in contractions with   !!!
!!!      the localis case ending              !!!
!!!      the 4SG quantifier-qualifier         !!!
!!!                                           !!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

LEXICON VerbEte

-[Quant_Qual][4Sg]ete[N→V]:%<%%~mete°   VerbPostbase;

! -------------------------------------------------------------|
!              Localis Case + -ete-  Contractions              |
! --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
!                      singular possessed                      |                         plural possessed                     |                             dual possessed                          |
! --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|-----------------|
-[Loc][SgUnpd]ete[N→V]:%<%%~mete°                  VerbPostbase; -[Loc][PlUnpd]ete[N→V]:%<%%~nete°                VerbPostbase; -[Loc][DuUnpd]ete[N→V]:%<%%%:(e)gnete°                  VerbPostbase; ! unpossessed   |
! -------------------------------------------------------------|--------------------------------------------------------------|---------------------------------------------------------------------|-----------------|
-[Loc][3SgPoss][SgPosd]ete[N→V]:%<%:(ng)anete°       VerbPostbase; -[Loc][3SgPoss][PlPosd]ete[N→V]:%<%:(ng)inete°     VerbPostbase; -[Loc][3SgPoss][DuPosd]ete[N→V]:%<%%%:(e)gkenete°         VerbPostbase; ! 3Sg possessor |
-[Loc][3PlPoss][SgPosd]ete[N→V]:%<%:(ng)atnete°      VerbPostbase; -[Loc][3PlPoss][PlPosd]ete[N→V]:%<%:(ng)itnete°    VerbPostbase; -[Loc][3PlPoss][DuPosd]ete[N→V]:%<%%%:(e)gketnete°        VerbPostbase; ! 3Pl possessor |
-[Loc][3DuPoss][SgPosd]ete[N→V]:%<%:(ng)agnete°      VerbPostbase; -[Loc][3DuPoss][PlPosd]ete[N→V]:%<–kegnete°        VerbPostbase; -[Loc][3DuPoss][DuPosd]ete[N→V]:%<%%%:(e)gkegnete°        VerbPostbase; ! 3Du possessor |
! -------------------------------------------------------------|--------------------------------------------------------------|---------------------------------------------------------------------|-----------------|
-[Loc][1SgPoss][SgPosd]ete[N→V]:%<–mnete°            VerbPostbase; -[Loc][1SgPoss][PlPosd]ete[N→V]:%<–mnete°          VerbPostbase; -[Loc][1SgPoss][DuPosd]ete[N→V]:%<%%%:(e)gemnete°         VerbPostbase; ! 1Sg possessor |
-[Loc][1PlPoss][SgPosd]ete[N→V]:%<–mten̄ete°          VerbPostbase; -[Loc][1PlPoss][PlPosd]ete[N→V]:%<–mten̄ete°        VerbPostbase; -[Loc][1PlPoss][DuPosd]ete[N→V]:%<%%%:(e)gemten̄ete°       VerbPostbase; ! 1Pl possessor |
-[Loc][1DuPoss][SgPosd]ete[N→V]:%<–megnete°          VerbPostbase; -[Loc][1DuPoss][PlPosd]ete[N→V]:%<–megnete°        VerbPostbase; -[Loc][1DuPoss][DuPosd]ete[N→V]:%<%%%:(e)gmegnete°        VerbPostbase; ! 1Du possessor |
! -------------------------------------------------------------|--------------------------------------------------------------|---------------------------------------------------------------------|-----------------|
-[Loc][2SgPoss][SgPosd]ete[N→V]:%<+p|.vnete°         VerbPostbase; -[Loc][2SgPoss][PlPosd]ete[N→V]:%<+p|.vnete°       VerbPostbase; -[Loc][2SgPoss][DuPosd]ete[N→V]:%<%%%:(e)gpenete°         VerbPostbase; ! 2Sg possessor |
-[Loc][2PlPoss][SgPosd]ete[N→V]:%<+p|.vcen̄ete°       VerbPostbase; -[Loc][2PlPoss][PlPosd]ete[N→V]:%<+p|.vcen̄ete°     VerbPostbase; -[Loc][2PlPoss][DuPosd]ete[N→V]:%<%%%:(e)gpecen̄ete°       VerbPostbase; ! 2Pl possessor |
-[Loc][2PlPoss][SgPosd]ete[N→V]:%<+p|.vcinete°       VerbPostbase; -[Loc][2PlPoss][PlPosd]ete[N→V]:%<+p|.vcinete°     VerbPostbase; -[Loc][2PlPoss][DuPosd]ete[N→V]:%<%%%:(e)gpecinete°       VerbPostbase; ! 2Pl possessor |
-[Loc][2DuPoss][SgPosd]ete[N→V]:%<+p|.vtegnete°      VerbPostbase; -[Loc][2DuPoss][PlPosd]ete[N→V]:%<+p|.vtegnete°    VerbPostbase; -[Loc][2DuPoss][DuPosd]ete[N→V]:%<%%%:(e)gpetegnete°      VerbPostbase; ! 2Du possessor |
! -------------------------------------------------------------|--------------------------------------------------------------|---------------------------------------------------------------------|-----------------|
-[Loc][4SgPoss][SgPosd]ete[N→V]:%<–minete°           VerbPostbase; -[Loc][4SgPoss][PlPosd]ete[N→V]:%<–minete°         VerbPostbase; -[Loc][4SgPoss][DuPosd]ete[N→V]:%<%%%:(e)gminete°         VerbPostbase; ! 4Sg possessor |
-[Loc][4PlPoss][SgPosd]ete[N→V]:%<–meggnete°         VerbPostbase; -[Loc][4PlPoss][PlPosd]ete[N→V]:%<–meggnete°       VerbPostbase; -[Loc][4PlPoss][DuPosd]ete[N→V]:%<%%%:(e)gmeggnete°       VerbPostbase; ! 4Pl possessor |
-[Loc][4DuPoss][SgPosd]ete[N→V]:%<–megnete°          VerbPostbase; -[Loc][4DuPoss][PlPosd]ete[N→V]:%<–megnete°        VerbPostbase; -[Loc][4DuPoss][DuPosd]ete[N→V]:%<%%%:(e)gmegnete°        VerbPostbase; ! 4Du possessor |
! -------------------------------------------------------------|--------------------------------------------------------------|---------------------------------------------------------------------|-----------------|


